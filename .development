# Public contract. Compose commands MUST use --env-file .development.
# Reserved cluster endpoints are contracts, not running Phase 0 services.
CONTRACT_VERSION=0.1
BOOTSTRAP_STATUS=runtime-verified
BASE_IMAGE_NAME=hadoop-base
BASE_IMAGE_TAG=v0.1
JDK_VERSION=1.8.0_442
HADOOP_VERSION=3.3.6
JAVA_HOME=/opt/java/openjdk
HADOOP_HOME=/opt/hadoop
HADOOP_CONF_DIR=/opt/hadoop/etc/hadoop
HADOOP_LOG_DIR=/opt/hadoop/logs
WORKSPACE=/workspace
MASTER_HOST=master
WORKER1_HOST=worker1
WORKER2_HOST=worker2
NAMENODE_SERVICE=NameNode
DATANODE_SERVICE=DataNode
RESOURCEMANAGER_SERVICE=ResourceManager
NODEMANAGER_SERVICE=NodeManager
HDFS_URI=hdfs://master:9000
HDFS_RPC_PORT=9000
NAMENODE_WEB_PORT=9870
YARN_WEB_PORT=8088
HDFS_NAMENODE_DIR=/var/lib/hadoop/hdfs/namenode
HDFS_DATANODE_DIR=/var/lib/hadoop/hdfs/datanode
WORDCOUNT_DIR=/workspace/apps/wordcount
MERGEFILE_DIR=/workspace/apps/mergefile
HDFS_INPUT_ROOT=/project/input
HDFS_OUTPUT_ROOT=/project/output
